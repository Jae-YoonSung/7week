  entries:
  - image: {fileID: 21300000, guid: acb0e748b3440324b90c729c31a40b45, type: 3}
    dialogueText: "\u201C\uC6B0\uB9AC\uC758 \uD0DC\uC591\uC744 \uB3CC\uB824\uC8FC\uC2ED\uC2DC\uC624\u201D"
    typewriterInterval: 0.05
    autoAdvanceDelay: 3
    doFadeTransition: 0
    fadeDuration: 0
  - image: {fileID: 0}
    dialogueText: "\uC0AC\uB77C\uC9C4 \uC601\uC6C5\uC744 \uCC3E\uB294 \uC77C\uACF1
      \uB9DD\uB839\uB4E4."
    typewriterInterval: 0.05
    autoAdvanceDelay: 3
    doFadeTransition: 0
    fadeDuration: 0
  - image: {fileID: 0}
    dialogueText: "\uAD6C\uB801\uD145\uC774\uB294 \uC5B4\uBBF8 \uCC3E\uB294 \uC0C8\uB07C
      \uC81C\uBE44\uCC98\uB7FC \uADF8\uB4E4\uC744 \uBC18\uACA8\uC628\uB2E4."
    typewriterInterval: 0.05
    autoAdvanceDelay: 3
    doFadeTransition: 0
    fadeDuration: 0
  - image: {fileID: 0}
    dialogueText: "\uADF8 \uB05D\uC774 \uB05D\uC5C6\uB294 \uD5C8\uBB34\uBFD0\uC774\uB77C\uB294
      \uAC78 \uC54C\uBA74\uC11C\uB3C4"
    typewriterInterval: 0.05
    autoAdvanceDelay: 3
    doFadeTransition: 0
    fadeDuration: 0.5
  - image: {fileID: 0}
    dialogueText: "\uC774\uB4E4\uC740 \uAE30\uAEBC\uC774 \uC790\uC2E0\uC758 \uBAB8\uC744
      \uC81C\uBB3C\uB85C \uBC14\uCE5C\uB2E4."
    typewriterInterval: 0.05
    autoAdvanceDelay: 3
    doFadeTransition: 0
    fadeDuration: 1
  - image: {fileID: 21300000, guid: 08b80bbc01916b746a087b5b03881019, type: 3}
    dialogueText: 
    typewriterInterval: 0
    autoAdvanceDelay: 0.01
    doFadeTransition: 1
    fadeDuration: 0.5
  - image: {fileID: 0}
    dialogueText: "\uD5C8\uB098,"
    typewriterInterval: 0.05
    autoAdvanceDelay: 3
    doFadeTransition: 0
    fadeDuration: 0.5
  - image: {fileID: 0}
    dialogueText: "\uC5B4\uB460\uC744 \uBC1D\uD600\uC8FC\uB358 \uCC2C\uB780\uD55C
      \uBAA8\uC2B5, \n\uC628\uD654\uD55C \uBE5B\uC758 \uC190\uAE38, \uC11D\uC591\uC758
      \uC9D9\uC740 \uD5A5\uAE30"
    typewriterInterval: 0.05
    autoAdvanceDelay: 3
    doFadeTransition: 0
    fadeDuration: 1
  - image: {fileID: 0}
    dialogueText: "\uC5B4\uB460\uC18D\uC5D0\uC11C \uC544\uB978\uAC70\uB9AC\uB294
      \uAE30\uC5B5\uC758 \uD30C\uD3B8\uB4E4\uC740 \n\uC774\uB4E4\uC744 \uAC08\uB77C\uB193\uAE30\uC5D0
      \uCDA9\uBD84\uD588\uB2E4."
    typewriterInterval: 0.05
    autoAdvanceDelay: 3
    doFadeTransition: 0
    fadeDuration: 1
  - image: {fileID: 0}
    dialogueText: "\uC790\uC2E0\uC774 \uD1A0\uD574\uB0B8 \uC2E4\uB9C8\uC800 \uD54F\uBE5B\uC73C\uB85C
      \uBB3C\uB4E4\uC77C\uC9C0\uB77C\uB3C4,"
    typewriterInterval: 0.05
    autoAdvanceDelay: 3
    doFadeTransition: 0
    fadeDuration: 0.5
  - image: {fileID: 0}
    dialogueText: "\uB204\uC5D0\uB294 \uD55C \uC90C\uC758 \uC7AC\uB85C \uD0C0\uB4E4\uC5B4
      \uAC08 \uBD88\uB098\uBC29\uC744 \uAFC8\uAFBC\uB2E4."
    typewriterInterval: 0.05
    autoAdvanceDelay: 3
    doFadeTransition: 0
    fadeDuration: 1
