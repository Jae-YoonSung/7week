  entries:
  - dialogueText: "\u201C\uC5B4\uB514\uAE4C\uC9C0\uAC00 \uB0B4 \uAC83\uC778\uAC00.\u201D"
    typewriterInterval: 0.05
    autoAdvanceDelay: 3
    characterSprite: {fileID: 21300000, guid: 2f9e99b41755efa438bcaf4807639541, type: 3}
    characterPosition: {x: 305, y: -322}
    characterSprite2: {fileID: 21300000, guid: 7b9addebb5e34694987157b082d8b446, type: 3}
    characterPosition2: {x: 566, y: -322}
    keepCharacter2: 1
    doFadeTransition: 0
    fadeDuration: 0
  - dialogueText: "\uD669\uC57C\uB97C \uAC74\uB108\uC628 7\uBA85\uC758 \uAC1C\uCC99\uC790\uB4E4."
    typewriterInterval: 0.05
    autoAdvanceDelay: 3
    characterSprite: {fileID: 0}
    characterPosition: {x: 305, y: -233}
    characterSprite2: {fileID: 0}
    characterPosition2: {x: 566, y: -233}
    keepCharacter2: 1
    doFadeTransition: 0
    fadeDuration: 0
  - dialogueText: "\uADF8\uB4E4\uC740 \uC5B8\uC81C\uB098 \uD568\uAED8\uC77C \uAC83\uC774\uB77C
      \uC0DD\uAC01\uD588\uB2E4. "
    typewriterInterval: 0.05
    autoAdvanceDelay: 3
    characterSprite: {fileID: 0}
    characterPosition: {x: 305, y: -322}
    characterSprite2: {fileID: 0}
    characterPosition2: {x: 566, y: -322}
    keepCharacter2: 1
    doFadeTransition: 0
    fadeDuration: 0
  - dialogueText: 
    typewriterInterval: 0.05
    autoAdvanceDelay: 0.01
    characterSprite: {fileID: 0}
    characterPosition: {x: 305, y: -322}
    characterSprite2: {fileID: 0}
    characterPosition2: {x: 566, y: -322}
    keepCharacter2: 1
    doFadeTransition: 0
    fadeDuration: 1
  - dialogueText: "\uC2DC\uAC04\uC774 \uC9C0\uB098 \uD558\uB098\uC758 \uBB38\uBA85\uC73C\uB85C
      \uC131\uC7A5\uD55C \uC9D1\uB2E8\uC740 \uC11C\uB85C\uC758 \uACBD\uACC4\uB97C
      \uC694\uAD6C\uD558\uAC8C \uB418\uACE0,"
    typewriterInterval: 0.05
    autoAdvanceDelay: 3
    characterSprite: {fileID: 21300000, guid: fd844ab0566af6f47abd4d47f746cf08, type: 3}
    characterPosition: {x: 305, y: -322}
    characterSprite2: {fileID: 21300000, guid: 3809809ed2bf65e42ab59dfe5960e9ca, type: 3}
    characterPosition2: {x: 566, y: -322}
    keepCharacter2: 1
    doFadeTransition: 1
    fadeDuration: 0.5
  - dialogueText: "\uB204\uAD70\uAC00\uB294 \uC548\uC5D0 \uB0A8\uACE0 \uB204\uAD70\uAC00\uB294
      \uBC16\uC73C\uB85C \uBC00\uB824\uB098\uAC8C \uB418\uC5C8\uB2E4."
    typewriterInterval: 0.05
    autoAdvanceDelay: 3
    characterSprite: {fileID: 0}
    characterPosition: {x: 305, y: -322}
    characterSprite2: {fileID: 0}
    characterPosition2: {x: 566, y: -322}
    keepCharacter2: 1
    doFadeTransition: 0
    fadeDuration: 1
  - dialogueText: 
    typewriterInterval: 0.05
    autoAdvanceDelay: 0.01
    characterSprite: {fileID: 0}
    characterPosition: {x: 305, y: -322}
    characterSprite2: {fileID: 0}
    characterPosition2: {x: 566, y: -322}
    keepCharacter2: 1
    doFadeTransition: 0
    fadeDuration: 1
  - dialogueText: "\uD55C \uC90C\uC758 \uB545\uC744 \uC9C0\uD0A4\uB824\uB294 \uB9C8\uC74C\uC740
      \uACE7 \uC815\uC758\uAC00 \uB418\uC5B4,"
    typewriterInterval: 0.05
    autoAdvanceDelay: 3
    characterSprite: {fileID: 21300000, guid: 1615b3adef5d09c41a39471a02609004, type: 3}
    characterPosition: {x: 305, y: -322}
    characterSprite2: {fileID: 21300000, guid: 7d31c821db1a8db41a6cca994552da77, type: 3}
    characterPosition2: {x: 566, y: -322}
    keepCharacter2: 1
    doFadeTransition: 1
    fadeDuration: 0.5
  - dialogueText: "\uB9C8\uCE68\uB0B4 \uAD11\uAE30\uB85C \uC774\uC5B4\uC9C4\uB2E4."
    typewriterInterval: 0.05
    autoAdvanceDelay: 3
    characterSprite: {fileID: 0}
    characterPosition: {x: 305, y: -322}
    characterSprite2: {fileID: 0}
    characterPosition2: {x: 566, y: -322}
    keepCharacter2: 1
    doFadeTransition: 0
    fadeDuration: 1
  - dialogueText: 
    typewriterInterval: 0.05
    autoAdvanceDelay: 0.01
    characterSprite: {fileID: 0}
    characterPosition: {x: 305, y: -322}
    characterSprite2: {fileID: 0}
    characterPosition2: {x: 566, y: -322}
    keepCharacter2: 1
    doFadeTransition: 0
    fadeDuration: 1
  - dialogueText: "\uC5B4\uB514\uAE4C\uC9C0\uAC00 \uB0B4 \uAC83\uC778\uAC00? "
    typewriterInterval: 0.05
    autoAdvanceDelay: 3
    characterSprite: {fileID: 21300000, guid: 0df084b771e551a428056fbba753e69a, type: 3}
    characterPosition: {x: 305, y: -322}
    characterSprite2: {fileID: 0}
    characterPosition2: {x: 566, y: -322}
    keepCharacter2: 0
    doFadeTransition: 1
    fadeDuration: 0.5
  - dialogueText: "\uC5B4\uB514\uAE4C\uC9C0\uAC00 \uD0C0\uC778\uC758 \uAD11\uAE30\uC778\uAC00?"
    typewriterInterval: 0.05
