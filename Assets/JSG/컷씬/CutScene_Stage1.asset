  m_Script: {fileID: 11500000, guid: aec38d1f37f6c004fb9f4fde9647142c, type: 3}
  m_Name: CutScene_Stage1
  m_EditorClassIdentifier: Assembly-CSharp::StageClearCutsceneSO
  backgroundImage: {fileID: 21300000, guid: b41a73a3c6326a54aab49b62d8bf4653, type: 3}
  lines:
  - "\uCC98\uC74C\uC5D0\uB294 \uADF8\uC800 \uC88B\uC558\uB2E4."
  - "\uCE5C\uAD6C\uB4E4\uACFC \uD568\uAED8 \uC5EC\uD589\uD558\uB294 \uAC83\uB3C4, "
  - "\uB9C8\uC744\uC744 \uC9C0\uCF1C\uB0B8 \uAC83\uB3C4, "
  - "\uAD6D\uAC00\uB97C \uAD6C\uD574\uB0B8 \uAC83\uB3C4."
  - "\uD558\uC9C0\uB9CC \uD658\uD638\uB294 \uB298 \uB2E4\uB978 \uB3D9\uB8CC\uB4E4\uC758
    \uBAAB\uC774\uC5C8\uB2E4."
  - "\uC5B4\uB290 \uB0A0 \uC870\uC774\uAC00 \uCC3E\uC544\uC654\uB2E4."
  - "\"\uC815\uB9D0 \uC6B0\uB9AC\uAC00 \uC633\uC558\uB098?\""
  - "\uAE30\uAC00 \uCC3C\uB2E4. "
  - "\uC8FC\uBAA9\uC740 \uC804\uBD80 \uC790\uAE30\uB4E4\uC774 \uBC1B\uC544\uB193\uACE0,
    \uC774\uC81C \uC640\uC11C \uD68C\uC758\uAC10\uC774\uB77C\uB2C8."
  - "\uD589\uD06C\uC640 \uCE74\uD504\uCE74\uB97C \uBCF4\uC558\uB2E4."
  - "\uD3C9\uBC94\uD55C \uC0B6\uC73C\uB85C \uB3CC\uC544\uAC00\uACA0\uB2E8\uB2E4.
    \uD589\uBCF5\uD574 \uBCF4\uC600\uB2E4."
  - "\uB098\uB294 \uD589\uBCF5\uD558\uC9C0 \uC54A\uC740\uB370."
  - "\uADF8\uB798\uC11C \uD589\uD06C\uB97C \uC8FD\uC600\uB2E4. \uCE74\uD504\uCE74\uB3C4
    \uD568\uAED8."
  - "\uB098\uB3C4 \uC601\uC6C5\uC774\uACE0 \uC2F6\uC5C8\uB2E4. "
  - "\uAC19\uC774 \uC2F8\uC6E0\uB294\uB370 \uC65C \uB098\uB9CC \uC544\uBB34\uAC83\uB3C4
    \uC544\uB2CC \uAC70\uC9C0?"
  - "\uADF8\uB808\uC774\uC2A4\uB294 \uC8FD\uC77C \uC218 \uC5C6\uC5C8\uB2E4. \n\uC6B0\uB9AC
    \uC911 \uAC00\uC7A5 \uAC15\uD588\uC73C\uB2C8\uAE4C."
  - "\uB300\uC2E0 \uAC70\uC9D3 \uC758\uB8B0\uB97C \uD558\uB098 \uB9CC\uB4E4\uC5C8\uB2E4. "
  - "\uB2E8\uC21C\uD55C \uADF8 \uC560\uB294 \uC758\uC2EC \uC5C6\uC774 \uB5A0\uB0AC\uB2E4.\r\n\uB3CC\uC544\uC62C
    \uC218 \uC5C6\uB294 \uACF3\uC73C\uB85C."
  - "\uAD8C\uB825\uC5D0 \uCDE8\uD574 \uB5A0\uB3CC\uB358 \uD2B8\uB798\uBE44\uC2A4\uB97C
    \uC8FD\uC600\uB2E4. \n\uCC98\uC74C\uBD80\uD130 \uC7AC\uC218 \uC5C6\uC5C8\uB2E4."
  - "\uB05D\uAE4C\uC9C0 \uC2E0\uB9CC \uCC3E\uB358 \uC2A4\uBBF8\uC2A4\uB97C \uC8FD\uC600\uB2E4.
    \n\uADF8 \uC2E0\uC740 \uACB0\uAD6D \uC624\uC9C0 \uC54A\uC558\uB2E4."
  - "\uC774\uC81C \uC870\uC774\uB9CC \uB0A8\uC558\uB2E4."
  - "\uC870\uC774\uAC00 \uB098\uB97C \uC124\uB4DD\uD558\uB824 \uD55C\uB2E4."
  - "\uD558\uC9C0\uB9CC \uBA48\uCD94\uAE30\uC5D0\uB294 \uB108\uBB34 \uBA40\uB9AC
    \uC640\uBC84\uB838\uB2E4."
  - "\uC6A9\uBCD1\uB2E8\uC5D0 \uB098\uB9CC \uB0A8\uC73C\uBA74, \uB098\uB9CC \uB0A8\uC73C\uBA74
    \u2014 \uB0B4\uAC00 \uC601\uC6C5\uC774 \uB418\uB2C8\uAE4C."
