  m_Script: {fileID: 11500000, guid: aec38d1f37f6c004fb9f4fde9647142c, type: 3}
  m_Name: CutScene_Stage4
  m_EditorClassIdentifier: Assembly-CSharp::StageClearCutsceneSO
  backgroundImage: {fileID: 21300000, guid: b41a73a3c6326a54aab49b62d8bf4653, type: 3}
  lines:
  - "\uC5B8\uC81C \uC774 \uC12C\uC5D0 \uC654\uB294\uC9C0 \uC774\uC81C\uB294 \uAE30\uC5B5\uB3C4
    \uB098\uC9C0 \uC54A\uB294\uB2E4."
  - "\uC2DD\uB7C9\uC740 \uB3D9\uC774 \uB09C\uC9C0 \uC624\uB798\uB2E4. \uC774\uC820
    \uBB3C\uB3C4 \uB2E4 \uB5A8\uC5B4\uC84C\uB2E4."
  - "<color=#6C9B6F>\uC2E4\uBE44\uC544</color>\uAC00 \uBBF8\uCCE4\uB294\uC9C0 \uC18C\uB9AC\uB97C
    \uC9C0\uB974\uBA70 \uD30C\uB3C4\uB85C \uB2EC\uB824\uAC14\uB2E4."
  - "<color=#6C9B6F>\uC2E4\uBE44\uC544</color>\uB97C \uAD6C\uD558\uB7EC \uBD80\uBD80\uAC00
    \uB2EC\uB824\uAC14\uC9C0\uB9CC 3\uBA85\uC740 \uB3CC\uC544\uC624\uC9C0 \uBABB\uD588\uB2E4."
  - "\uBA4D\uCCAD\uD55C <color=#283FEB>\uB85C\uC6F0</color>.. \uBA4D\uCCAD\uD55C
    <color=#880095>\uBBF8\uB77C</color>\u2026"
  - "\uC9C0\uB098\uAC00\uB294 \uBC30 \uD558\uB098 \uC5C6\uB294 \uC12C."
  - "\uB354 \uC774\uC0C1 \uD76C\uB9DD\uC744 \uD488\uB294 \uAC83\uC740 \uBB34\uC758\uBBF8
    \uD558\uB2E4."
  - "\uBC30\uAC00 \uB108\uBB34 \uACE0\uD320\uB2E4.\r\n\uAC00\uB054 \uBCF4\uC774\uB294
    \uAC1C\uBBF8\uB4E4\uB85C\uB294 \uB0B4 \uD5C8\uAE30\uB97C \uCC44\uC6B8 \uC218
    \uC5C6\uC5C8\uB2E4."
  - "\uC0DD\uAC01\uD574\uBCF4\uB2C8 \uC0AC\uB78C\uB3C4 \uACE0\uAE30\uAC00 \uC544\uB2CC\uAC00?"
  - "<color=#A3417D>\uD1A0\uBE44\uC544\uC2A4</color>\uB97C \uC8FD\uC774\uAE30\uB85C
    \uB9C8\uC74C\uBA39\uC5C8\uB2E4."
  - "<color=#C4B279>\uC5D0\uB4DC\uAC70</color>\uB97C \uC0AC\uB0E5 \uD551\uACC4\uB85C
    \uC12C \uC548\uCABD\uC73C\uB85C \uBCF4\uB0C8\uB2E4."
  - "\uC774\uC81C \uACC4\uD68D\uC744 \uC2E4\uD589\uD558\uAE30\uB85C \uB9C8\uC74C
    \uBA39\uC5C8\uB2E4."
  - "\uB3CC\uC744 \uB4E4\uACE0 \uCC9C\uCC9C\uD788 <color=#A3417D>\uD1A0\uBE44\uC544\uC2A4</color>\uC5D0\uAC8C
    \uB2E4\uAC00\uAC14\uB2E4."
  - "\uB0B4\uB9AC\uCE58\uB824\uB294 \uC21C\uAC04 \uBE4C\uC5B4\uBA39\uC744 \uC608\uC218\uC7C1\uC774\uAC00
    \uB0A0 \uB36E\uCCE4\uB2E4."
  - "\uADF8\uB798\uC11C \uC608\uC218\uC7C1\uC774 <color=#932E35>\uC774\uC0AC\uBCA8</color>\uC744
    \uB0B4\uB824\uCCE4\uB2E4."
  - "<color=#A3417D>\uD1A0\uBE44\uC544\uC2A4</color>\uB294 \uC0AC\uC0C9\uC774 \uB418\uC5C8\uB2E4."
  - "<color=#A3417D>\uD1A0\uBE44\uC544\uC2A4</color>\uAC00 \uC544\uB2CC\uB4E4 \uC5B4\uB5A0\uD55C\uAC00
    <color=#932E35>\uC774\uC0AC\uBCA8</color>\uB3C4 \uC0AC\uB78C\uC778\uB370."
  - "\uCD95 \uCC98\uC9C4 <color=#932E35>\uC774\uC0AC\uBCA8</color>\uC744 \uB4E4\uCCD0
    \uC5C5\uACE0 \uAC70\uCC98\uB97C \uB5A0\uB0AC\uB2E4."
  - "<color=#A3417D>\uD1A0\uBE44\uC544\uC2A4</color>\uB294 \uAC81\uC5D0 \uC9C8\uB824
    \uC6C0\uC9C1\uC774\uC9C0\uB3C4 \uBABB\uD588\uB2E4."
  - "\uADF8\uAC74 \uB098\uC911\uC5D0 \uD574\uB3C4 \uB41C\uB2E4."
  - "\uC624\uB79C\uB9CC\uC5D0 \uBC30\uB97C \uCC44\uC6E0\uB2E4."
  - "\uBC30\uAC00 \uCC28\uB2C8 \uACE0\uD5A5 \uC0DD\uAC01\uC774 \uB0AC\uB2E4.\r\n\uC5EC\uAE30\uC11C
    \uC774\uB807\uAC8C \uC8FD\uC744 \uC21C \uC5C6\uB2E4."
  - "<color=#C4B279>\uC5D0\uB4DC\uAC70</color>\uAC00 \uC0AC\uB0E5\uC5D0\uC11C \uB3CC\uC544\uC654\uB2E4. "
  - "\uB3CC\uC744 \uB4E4\uC5C8\uB2E4. \uC774\uAC83\uB9CC \uB05D\uB0B4\uBA74 \uB3CC\uC544\uAC08
    \uC218 \uC788\uB2E4."
  - "\uC544\uB9C8... \uADF8\uB7F4 \uAC70\uB2E4."
  - "\uADFC\uB370 \uC774\uB188\uC774 \uC65C \uC6C3\uACE0 \uC788\uC9C0?"
