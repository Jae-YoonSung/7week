  m_Script: {fileID: 11500000, guid: aec38d1f37f6c004fb9f4fde9647142c, type: 3}
  m_Name: CutScene_Stage3
  m_EditorClassIdentifier: Assembly-CSharp::StageClearCutsceneSO
  backgroundImage: {fileID: 21300000, guid: b41a73a3c6326a54aab49b62d8bf4653, type: 3}
  lines:
  - "\uC6B0\uB9AC\uB294 \uC783\uC5B4\uBC84\uB9B0 \uD0DC\uC591\uC744 \uC548\uACE0
    \uC2F6\uC5C8\uC744 \uBFD0\uC774\uC5C8\uB2E4."
  - "\uD558\uC9C0\uB9CC \uBE5B\uC774 \uBC14\uB79C \uC2EC\uC5F0 \uC18D\uC5D0\uC11C
    \uC6B0\uB9AC\uC758 \uAC00\uC5FE\uC740 \uBBFF\uC74C\uC740 \uC11C\uC11C\uD788 \uC5BC\uC5B4\uBD99\uC5C8\uB2E4."
  - "\uAC00\uC7A5 \uC5EC\uB9B0 <color=#C4B279>\uCF54\uB9B0</color>\uC774 \uACF5\uD3EC\uC5D0
    \uC7A0\uACA8 \uC2A4\uB7EC\uC9C0\uB358 \uBC24."
  - "\uC5B4\uB460\uC5D0 \uAE38\uC744 \uC783\uC740 <color=#A64B81>\uC774\uBCA8\uB9B0</color>\uC774
    \uCE7C\uB0A0\uC744 \uC138\uC6E0\uC744 \uB54C,"
  - "<color=#880095>\uC790\uD558\uB77C</color>\uB294 \uBD89\uC740 \uD53C\uB97C \uD758\uB9AC\uBA74\uC11C\uB3C4
    \uAE30\uAEBC\uC774 \uADF8 \uC11C\uAE00\uD508 \uCE7C\uB05D\uC744 \uD488\uC5B4
    \uC548\uC558\uB2E4."
  - "\uCC38\uD639\uD55C \uBE44\uADF9 \uC18D\uC5D0\uC11C <color=#C4B279>\uCE74\uC5D8</color>\uC740
    <color=#A64B81>\uC774\uBCA8\uB9B0</color>\uC744 \uBCA0\uC5B4\uB0C8\uC73C\uB098,"
  - "<color=#A64B81>\uC774\uBCA8\uB9B0</color>\uC758 \uCE7C\uB0A0\uC740 <color=#555555>\uCE74\uC774\uB860</color>\uC758
    \uC228\uB9C8\uC800 \uAC70\uB450\uC5C8\uACE0"
  - "<color=#555555>\uCE74\uC774\uB860</color>\uACFC \uC6B4\uBA85\uC744 \uD568\uAED8\uD558\uAE30\uB85C
    \uC57D\uC18D\uD55C <color=#6C9B6F>\uCE74\uC5D8</color>\uC740 \uD640\uB85C \uC5B4\uB514\uB860\uAC00
    \uC0AC\uB77C\uC838\uBC84\uB838\uB2E4."
  - "<color=#00168F>\uB178\uC544</color>\uC758 \uBB35\uBB35\uD55C \uBC1C\uAC78\uC74C\uB9CC\uC774
    \uC6B0\uB9AC\uC758 \uAC00\uB0D8\uD508 \uD76C\uB9DD\uC774\uC5C8\uB2E4."
  - "\uADF8\uB7EC\uB098 \uBC14\uB2E5\uC5D0 \uB2FF\uAE30 \uC9C1\uC804, \uADF8\uB9C8\uC800\uB3C4
    \uACE0\uC694\uD788 \uB208\uC744 \uAC10\uACE0 \uB9D0\uC558\uB2E4."
  - "\uACB0\uAD6D \uB098\uB9CC\uC774 \uD640\uB85C \uD145 \uBE48 \uAD6C\uB801\uD145\uC774\uC758
    \uB05D\uC5D0 \uB2FF\uC558\uB2E4."
  - "\uD558\uC9C0\uB9CC \uC6B0\uB9AC\uAC00 \uADF8\uD1A0\uB85D \uCC3E\uC544 \uD5E4\uB9E4\uB358
    \uD0DC\uC591\uC740 \uADF8 \uC5B4\uB514\uC5D0\uB3C4 \uC5C6\uC5C8\uB2E4."
  - "\uC7BF\uB354\uBBF8\uAC00 \uB41C \uB3D9\uB8CC\uB4E4\uC758 \uD754\uC801 \uC704\uB85C
    \uD76C\uBBF8\uD558\uAC8C \uBC14\uC2A4\uB77C\uC9C0\uB294 \uB0B4 \uB450 \uC190\uC774
    \uBCF4\uC600\uB2E4."
  - "\uC544, \uC6B0\uB9AC\uB294 \uC2A4\uC2A4\uB85C\uAC00 \uD0DC\uC591\uC778 \uC904\uB3C4
    \uBAA8\uB974\uACE0 \uC11C\uB85C\uC758 \uBE5B\uC744 \uB044\uACE0 \uC788\uC5C8\uAD6C\uB098."
  - "\uC77C\uACF1\uC758 \uC628\uAE30\uAC00 \uBAA8\uC5EC\uC57C\uB9CC \uD53C\uC5B4\uB098\uB294
    \uC544\uC2A4\uB77C\uD55C \uBE5B\uC744."
  - "\uD640\uB85C \uB0A8\uC740 \uB098\uC758 \uBE5B\uB9C8\uC800 \uC7AC\uAC00 \uB418\uC5B4
    \uD769\uC5B4\uC9C0\uB294 \uC9C0\uAE08\uC5D0\uC57C,"
  - "\uC0AC\uBB34\uCE58\uAC8C \uB530\uC2A4\uD55C \uC9C4\uC2E4\uC744 \uB9C8\uC8FC\uD55C\uB2E4."
  backgroundChanges: []
