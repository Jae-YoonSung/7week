  m_Script: {fileID: 11500000, guid: aec38d1f37f6c004fb9f4fde9647142c, type: 3}
  m_Name: CutScene_Stage2
  m_EditorClassIdentifier: Assembly-CSharp::StageClearCutsceneSO
  backgroundImage: {fileID: 21300000, guid: b41a73a3c6326a54aab49b62d8bf4653, type: 3}
  lines:
  - "\uC5B4\uB290 \uB0A0, \uC6D0\uC8FC\uBBFC \uD55C \uBA85\uACFC \uD558\uC580 \uD53C\uBD80\uB97C
    \uAC00\uC9C4 \uC0AC\uB78C\uB4E4\uC774 \uB9C8\uC744\uC5D0 \uC654\uB2E4."
  - "<color=#953A3F>\uC5D8\uB7EC\uC774\uC5B4\uC2A4</color>\uB77C\uB294 \uC0AC\uB78C\uC774
    \uC790\uC2E0\uC774 \uC628 \uACF3\uC5D0 \uB300\uD574 \uC774\uC57C\uAE30\uD574
    \uC8FC\uC5C8\uB2E4."
  - "\uBD88\uC744 \uBFDC\uB294 \uCD1D, \uCE7C\uC744 \uB9C9\uB294 \uCCA0\uC81C \uAC11\uC637,
    \uB192\uC774\uAC00 100m\uC5D0 \uB2EC\uD558\uB294 \uC131\uB2F9."
  - "\uAC00\uC2B4\uC774 \uB6F0\uC5C8\uB2E4. \uADF8\uB7F0 \uC138\uC0C1\uC744 \uBCF4\uACE0
    \uC2F6\uC5C8\uB2E4."
  - "\uADF8\uB807\uAC8C \uC5EC\uC815\uC744 \uB5A0\uB0AC\uB2E4."
  - "\uC624\uB79C \uC2DC\uAC04\uC774 \uC9C0\uB098, \uC6B0\uB9AC\uB294 \uD558\uB098\uC758
    \uC138\uC0C1\uC744 \uB9CC\uB4E4\uC5B4\uB0C8\uB2E4."
  - "\uAC01\uC790 \uB545\uC744 \uB098\uB204\uC5C8\uB2E4."
  - "\uACF5\uD3C9\uD558\uAC8C \uB098\uB208 \uC904 \uC54C\uC558\uC5C8\uB2E4."
  - "\uADF8\uB798\uC57C\uB9CC \uD588\uB2E4."
  - "\uB545 \uBD84\uBC30\uAC00 \uB9C8\uC74C\uC5D0 \uB4E4\uC9C0 \uC54A\uC558\uB358
    <color=#953A3F>\uC5D8\uB7EC\uC774\uC5B4\uC2A4</color>\uAC00 <color=#C4B279>\uC870\uB098</color>\uC758
    \uB545\uC744 \uCE68\uB7B5\uD588\uB2E4."
  - "<color=#880095>\uC0AC\uC77C\uB7EC\uC2A4</color>\uB294 \uC2DD\uC5B4\uAC00\uB294
    <color=#C4B279>\uC870\uB098</color>\uC758 \uC2DC\uC2E0\uC744 \uC548\uACE0 \n\uC6B8\uBD80\uC9D6\uC73C\uBA70
    <color=#953A3F>\uC5D8\uB7EC\uC774\uC5B4\uC2A4</color>\uC5D0\uAC8C \uB545\uC744
    \uB118\uACBC\uB2E4."
  - "<color=#0A2FFF>\uD074\uB77C\uB77C</color>\uB294 \uC790\uAE30 \uB545\uC758 \uACBD\uACC4\uB9C8\uB2E4
    \uB36B\uC744 \uB193\uC558\uB2E4."
  - "\uD558\uC9C0\uB9CC \uB108\uBB34\uB098\uB3C4 \uAC15\uB825\uD574\uC9C4 <color=#953A3F>\uC5D8\uB7EC\uC774\uC5B4\uC2A4</color>\uB97C
    \uB9C9\uC744 \uC21C \uC5C6\uC5C8\uB2E4."
  - "\uB3D5\uACE0 \uC2F6\uC5C8\uC9C0\uB9CC \uADF8\uB7F4 \uC218 \uC5C6\uC5C8\uB2E4."
  - "\uB36B\uC740 \uC544\uAD70\uACFC \uC801\uAD70\uC744 \uAC00\uB9AC\uC9C0 \uC54A\uC558\uAE30\uC5D0."
  - "\uBA48\uCD94\uB77C\uACE0 \uC18C\uB9AC\uCCE4\uB2E4. \uC544\uBB34\uB3C4 \uB4E3\uC9C0
    \uC54A\uC558\uB2E4."
  - "\uD558\uB098\uB458 \uC4F0\uB7EC\uC838 \uAC14\uB2E4."
  - "\uACB0\uAD6D <color=#953A3F>\uC5D8\uB7EC\uC774\uC5B4\uC2A4</color>\uB3C4 \uC8FD\uC5C8\uB2E4.\n<color=#0A2FFF>\uD074\uB77C\uB77C</color>\uAC00
    \uC8FD\uAE30 \uC804 \uB9CC\uB4E4\uC5B4\uB454 \uB36B\uC5D0 \uC758\uD574."
  - "\uB098\uB294 \uC544\uBB34\uAC83\uB3C4 \uAC00\uC9C0\uC9C0 \uC54A\uC558\uB2E4.\n\uADF8\uB798\uC11C
    \uC544\uBB34\uB3C4 \uB098\uB97C \uC8FD\uC774\uB824 \uD558\uC9C0 \uC54A\uC558\uB2E4."
  - "\uB113\uC5B4\uC9C4 \uB545 \uD55C\uAC00\uC6B4\uB370 \uB098\uB9CC \uB0A8\uC558\uB2E4."
  - "\uCD1D\uB3C4 \uC788\uB2E4. \uAC11\uC637\uB3C4 \uC788\uB2E4. \uB192\uC740 \uAC74\uBB3C\uC758
    \uAF2D\uB300\uAE30\uAC00 \uBCF4\uC778\uB2E4."
  - "\uAC00\uC2B4\uC774 \uB6F0\uC5C8\uB358 \uADF8 \uBAA8\uB4E0 \uAC83\uC774 \uB0B4
    \uC190 \uC548\uC5D0 \uB4E4\uC5B4\uC654\uB2E4."
  - "\uC6D0\uD55C \uAC74 \uC774\uB7F0 \uAC8C \uC544\uB2C8\uC5C8\uB2E4."
  - "\uB098\uB294 \uADF8\uC800 \uBCF4\uACE0 \uC2F6\uC5C8\uC744 \uBFD0\uC774\uC5C8\uB294\uB370."
  backgroundChanges: []
